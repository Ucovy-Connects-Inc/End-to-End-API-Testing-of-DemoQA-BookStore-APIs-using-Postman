    {
      "name": "Get Books from library",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "{\r",
              "pm.test(\"Book list is present\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"books\");\r",
              "    pm.expect(jsonData.books.length).to.be.above(0);\r",
              "\r",
              "})\r",
              "const jsonData = pm.response.json();\r",
              "const isbnsArray = jsonData.books.map(book => book.isbn);\r",
              "pm.globals.set(\"isbnsArray\", JSON.stringify(isbnsArray));\r",
              "pm.globals.set(\"isbnIndex\", 0);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "//get book from library"
        },
        "url": {
          "raw": "{{BaseUrl}}/BookStore/v1/Books",
          "host": [
            "{{BaseUrl}}"
          ],
          "path": [
            "BookStore",
            "v1",
            "Books"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Books added and ISBNs stored\", function () {\r",
              "\r",
              "    pm.expect(pm.response.code).to.eql(400);\r",
              "\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    // Extract ISBNs into array\r",
              "    const isbnArray = response.books.map(book => book.isbn);\r",
              "\r",
              "    // Save as GLOBAL variable (stringified)\r",
              "    pm.globals.set(\"isbnsArray\", JSON.stringify(isbnArray));\r",
              "\r",
              "    // Optional: reset loop index for PUT\r",
              "    pm.globals.set(\"isbnIndex\", 0);\r",
              "    const jsonResponse=pm.message;\r",
              "    pm.expect(jsonResponse).to.have.property(\"code\", \"1210\");\r",
              "    console.info(\"Json data\"+jsonResponse)\r",
              "\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "\r",
              "\r",
              "// Get ISBN array from globals\r",
              "const isbns = JSON.parse(pm.globals.get(\"isbnsArray\"));\r",
              "\r",
              "// Build collectionOfIsbns payload\r",
              "const collection = isbns.map(isbn => ({\r",
              "    isbn: isbn\r",
              "}));\r",
              "\r",
              "// Log number of books\r",
              "console.info(\"No of books Added: \" + collection.length);\r",
              "\r",
              "// Save payload as global variable\r",
              "pm.globals.set(\"isbnPayload\", JSON.stringify(collection));\r",
              "\r",
              "// Generate a safe random index\r",
              "const randomIndex = Math.floor(Math.random() * collection.length);\r",
              "\r",
              "// Pick a random ISBN\r",
              "const randomISBN = collection[randomIndex].isbn;\r",
              "\r",
              "// Save random ISBN\r",
              "pm.globals.set(\"randomISBN\", randomISBN);\r",
              "\r",
              "console.info(\"Random ISBN selected: \" + randomISBN);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
